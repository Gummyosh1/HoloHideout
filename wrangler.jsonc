{
  "name": "holo-hideout",
  "main": "app-worker.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*",
      "/admin.html"
    ]
  },
  "vars": {
    "GOOGLE_CALENDAR_ID": "connorlafferty0@gmail.com",
    "ACCESS_AUD": "6a857d1b7d819012c17e58b233fe0443c460bcff09fa19e828f2fae2c7d8e255",
    "ACCESS_TEAM_DOMAIN": "square-frog-0116.cloudflareaccess.com",
    "EMAIL_FROM": "contact@laffertyco.design",
    "SITE_URL": "https://holo-hideout.summer-lab-b538.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "holo-hideout-bookings",
      "database_id": "d5710f88-d0a5-48d2-a333-be43374bf5fb",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
